{
    "name":"asconsulting/contao_states",
    "description":"A basic States extensions for Contao CMS",
    "homepage": "https://andrewstevens.consulting",
    "keywords":["contao", "states", "provinces"],
    "type":"contao-module",
    "license":"LGPL-3.0-or-later",
    "authors":[
        {
            "name":"Andrew Stevens",
            "homepage":"https://andrewstevens.consulting"
        }
    ],
    "require":{
        "php": ">=8.1",
        "contao/core-bundle": "^5.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
	"autoload": {
        "psr-4": {
            "ContaoStates\\": "src/"
        }
    },
	"extra": {
		"contao-manager-plugin": "ContaoStates\\ContaoManager\\Plugin"
	},
    "minimum-stability": "dev"
}
